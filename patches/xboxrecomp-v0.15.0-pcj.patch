+/* ---- save-state gate (xbox_snapshot.h) ----------------------------------
+ * While a save or load copies guest RAM, no other guest thread may run guest
+ * code or a kernel call that writes guest memory. Spawned guest threads are
+ * counted while they run guest code; they stop counting inside the calls
+ * that only wait (sleeps, waits, critical sections), and with the gate up a
+ * thread coming back from any kernel call parks before it returns to guest
+ * code. The gate holder waits for the count to reach zero. */
+static volatile LONG g_snap_gate, g_snap_running;
+static RECOMP_TLS int s_snap_counted;
+static int snap_waits(ULONG ordinal)
+{
+    switch (ordinal) {
+    case 99:  /* KeDelayExecutionThread */
+    case 158: case 159:  /* KeWaitForMultipleObjects / KeWaitForSingleObject */
+    case 233: case 234: case 235:  /* NtWaitForSingleObject(Ex) / NtWaitForMultipleObjectsEx */
+    case 238:  /* NtYieldExecution */
+    case 277:  /* RtlEnterCriticalSection */
+        return 1;
+    }
+    return 0;

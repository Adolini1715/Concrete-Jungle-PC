+static void snap_thread_join(void) { s_snap_counted = 1; InterlockedIncrement(&g_snap_running); }
+static void snap_thread_part(void) { if (s_snap_counted) { s_snap_counted = 0; InterlockedDecrement(&g_snap_running); } }
+int xbox_snap_gate(int on, int timeout_ms)
+{
+    int i;
+    if (!on) { InterlockedExchange(&g_snap_gate, 0); return 1; }
+    InterlockedExchange(&g_snap_gate, 1);
+    for (i = 0; i < timeout_ms; i++) {
+        if (InterlockedCompareExchange(&g_snap_running, 0, 0) <= 0) return 1;
+        Sleep(1);
+    }
+    return 0;
+}

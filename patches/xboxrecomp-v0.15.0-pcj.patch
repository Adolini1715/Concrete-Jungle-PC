+        probs.insert(0, f"flag:{kind[1]} x86={ref[0x7C]} C={g[0x7C]} a={fdesc(c['xmm'][0])}.. mem={fdesc(c['mem'][0])},{fdesc(c['mem'][1])}")
+    return probs
+
+
+if __name__ == "__main__":
+    sys.exit(main())

+/* Host-side state regions for save states (project hook). Each module lists
+ * the static state that must travel with guest RAM for a restored game to
+ * resume: the pushbuffer walk position, the GPU register shadow, the vertex
+ * program, the kernel's allocator tables, the GPU MMIO page. Diagnostics and
+ * caches are left out. Regions are only valid in the process that listed
+ * them (they are host pointers); a file format must store them by name. */
+#ifndef XBOX_SNAPSHOT_H
+#define XBOX_SNAPSHOT_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct { void *p; size_t n; const char *name; } XboxSnapRegion;
+int nv2a_pb_scan_snap_regions(XboxSnapRegion *r, int max);
+int nv2a_pb_exec_snap_regions(XboxSnapRegion *r, int max);
+int nv2a_vsh_snap_regions(XboxSnapRegion *r, int max);
+int xbox_layout_snap_regions(XboxSnapRegion *r, int max);
+int mcpx_apu_snap_regions(XboxSnapRegion *r, int max);
+void mcpx_apu_snap_lock(int on);   /* hold the audio frame thread */
+/* park the GPU walk thread between ticks (on=1; wait_idle: drain to PUT first) / resume (on=0) */
+int xbox_nv2a_pause(int on, int wait_idle);
+/* hold every other guest thread out of guest code (on=1; waits up to timeout_ms for them
+ * to stop, returns 1 when they have) / let them go (on=0) */
+int xbox_snap_gate(int on, int timeout_ms);
+/* open files in the kernel handle table: their read positions, so sequential reads (streamed
+ * music, loading) continue from the saved place after a load */
+typedef struct { uint32_t slot; int64_t pos, size; char path[260]; } XboxSnapFile;
+int xbox_snap_files(XboxSnapFile *f, int max);
+int xbox_snap_files_restore(const XboxSnapFile *f, int n);   /* returns how many were put back */
+/* live worker-thread stacks [lo, hi) in guest VAs; returns the count */
+int xbox_worker_stacks(uint32_t *lo, uint32_t *hi, int max);
+#ifdef __cplusplus
+}
+#endif
+#endif

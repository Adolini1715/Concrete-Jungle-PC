+            FN[i]();
+            printf("%zu ", i);
+            for (k = 0; k < 0x200; k++) printf("%02X", m[0x200000 + k]);
+            printf("\n");
+            fflush(stdout);
+            _exit(0);
+        }
+        waitpid(pid, NULL, 0);
+    }
+    return 0;
+}
+"""

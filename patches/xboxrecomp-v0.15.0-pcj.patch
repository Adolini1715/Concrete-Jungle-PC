+        return (f"fld dword ptr [0x{MOP:x}]\nfcomp dword ptr [0x{MOP + 4:x}]\nfnstsw ax\nsahf", ("flags", jcc))
+    mask = rng.choice([0x41, 0x01, 0x40, 0x05, 0x44, 0x45])
+    jcc = rng.choice(["je", "jne", "jp", "jnp"])
+    return (f"fld dword ptr [0x{MOP:x}]\nfcomp dword ptr [0x{MOP + 4:x}]\nfnstsw ax\ntest ah, {mask}", ("flags", jcc))
+
+
+GENS = {"sse_scalar": g_sse_scalar, "sse_packed": g_sse_packed, "shufps": g_shufps, "movlh": g_movlh,
+        "comi": g_comi, "cvt": g_cvt, "mmx": g_mmx, "mmx_shift": g_mmx_shift, "mmx_misc": g_mmx_misc,
+        "x87_arith": g_x87_arith, "x87_unary": g_x87_unary, "x87_special": g_x87_binary_special,
+        "x87_int": g_x87_int, "x87_cmp": g_x87_cmp}
+
+
+def make_case(rng, g):
+    body, kind = GENS[g](rng)
+    mem = [rf(rng) for _ in range(4)]
+    if g == "x87_int" or g == "cvt":
+        mem[2] = D.rv(rng)
+        if rng.random() < 0.5: mem[0] = f2u(rng.choice([0.5, 1.5, 2.5, -0.5, -1.5, -2.5, 3.7, -3.7, 1e9, -1e9, 0.49999997, 123456.7, -0.0]))
+    if g.startswith("mmx"):
+        mem = [D.rv(rng) for _ in range(4)]
+    x = [rf(rng) if not g.startswith("mmx") else D.rv(rng) for _ in range(16)]
+    mmv = [D.rv(rng) for _ in range(4)]
+    regs = [D.rv(rng) for _ in D.REGS]
+    if g == "cvt" and rng.random() < 0.5:
+        regs = [rng.choice([0, 1, -1 & 0xFFFFFFFF, 0x7FFFFFFF, 0x80000000, 16777217, 123456789, 0xFFFFFF00]) for _ in D.REGS]
+    jcc = kind[1] if isinstance(kind, tuple) else "jb"
+    return dict(gen=g, body=body, kind=kind, regs=regs, xmm=x, mm=mmv, mem=mem, jcc=jcc)
+
+
+def asm_for(c, i):
+    L = [f"mov {r}, dword ptr [0x{S + 4 * k:x}]" for k, r in enumerate(D.REGS)]
+    L += [f"movups {x}, xmmword ptr [0x{XIN + 16 * k:x}]" for k, x in enumerate(XM)]
+    L += [f"movq mm{k}, qword ptr [0x{MIN + 8 * k:x}]" for k in range(2)]
+    L += ["clc"]
+    L += c["body"].split("\n")
+    L += [f"{c['jcc']} L_t{i}", f"mov byte ptr [0x{D.TAKEN:x}], 0", f"jmp L_d{i}", f"L_t{i}:",
+          f"mov byte ptr [0x{D.TAKEN:x}], 1", f"L_d{i}:"]
+    L += [f"movups xmmword ptr [0x{XOUT + 16 * k:x}], {x}" for k, x in enumerate(XM)]
+    L += [f"movq qword ptr [0x{MOUT + 8 * k:x}], mm{k}" for k in range(2)]
+    L += ["emms"]
+    L += [f"mov dword ptr [0x{D.OUT + 4 * k:x}], {r}" for k, r in enumerate(D.REGS)]
+    L += ["ret"]
+    return "\n".join(L)
+
+
+def init_bytes(c):
+    b = bytearray(0x200)
+    for k, v in enumerate(c["regs"]): b[4 * k:4 * k + 4] = v.to_bytes(4, "little")
+    for k, v in enumerate(c["xmm"]): b[0x100 + 4 * k:0x104 + 4 * k] = v.to_bytes(4, "little")
+    for k, v in enumerate(c["mm"]): b[0x140 + 4 * k:0x144 + 4 * k] = v.to_bytes(4, "little")
+    for k, v in enumerate(c["mem"]): b[0x150 + 4 * k:0x154 + 4 * k] = v.to_bytes(4, "little")
+    return bytes(b)
+
+
+def run_unicorn(c):
+    mu = unicorn.Uc(unicorn.UC_ARCH_X86, unicorn.UC_MODE_32)
+    mu.mem_map(0, 0x400000)
+    mu.mem_write(c["addr"], c["code"])
+    mu.mem_write(S, init_bytes(c))
+    mu.reg_write(U.UC_X86_REG_ESP, D.STACK - 4)
+    mu.mem_write(D.STACK - 4, (0x0FFF0).to_bytes(4, "little"))
+    # SSE needs CR4.OSFXSR; unicorn enables it for 32-bit mode
+    try:
+        mu.emu_start(c["addr"], 0x0FFF0, count=10000)
+    except unicorn.UcError:
+        return None
+    return bytes(mu.mem_read(S, 0x200))
+
+
+HARNESS_MAIN = r"""
+int main(void) {
+    uint8_t *m = calloc(1, 0x400000);
+    size_t i;

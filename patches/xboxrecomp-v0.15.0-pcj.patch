+    return (f"fnstcw word ptr [0x{FOUT + 12:x}]\nmov ax, word ptr [0x{FOUT + 12:x}]\nor ax, 0x0C00\n"
+            f"mov word ptr [0x{FOUT + 14:x}], ax\nfldcw word ptr [0x{FOUT + 14:x}]\n"
+            f"fld dword ptr [0x{MOP:x}]\nfistp dword ptr [0x{FOUT:x}]\nfldcw word ptr [0x{FOUT + 12:x}]"), "x87int"
+
+
+def g_x87_cmp(rng):
+    k = rng.choice(["fcomip", "fucomip", "fcomp_sahf", "fcomp_test"])
+    jcc = rng.choice(["ja", "jae", "jb", "jbe", "je", "jne", "jp", "jnp"])
+    if k in ("fcomip", "fucomip"):
+        return (f"fld dword ptr [0x{MOP + 4:x}]\nfld dword ptr [0x{MOP:x}]\n{k} st(0), st(1)\nfstp st(0)", ("flags", jcc))

+
+
+def g_mmx_misc(rng):
+    k = rng.choice(["movd_r", "movd_x", "pshufw", "movq"])
+    if k == "movd_r": return f"movd {rng.choice(D.R32)}, {rng.choice(MM)}", "exact"
+    if k == "movd_x": return f"movd {rng.choice(MM)}, {rng.choice(D.R32)}", "exact"
+    if k == "pshufw": return f"pshufw {rng.choice(MM)}, {rng.choice(MM)}, {rng.randrange(256)}", "exact"
+    return f"movq {rng.choice(MM)}, qword ptr {MOPS}", "exact"
+
+
+# x87: operands come from the memory operand slot (two floats at MOP, MOP+4) and int at MOP+8
+def g_x87_arith(rng):
+    m = rng.choice(["fadd", "fsub", "fsubr", "fmul", "fdiv", "fdivr"])
+    form = rng.choice(["st", "mem", "p"])
+    if form == "mem":
+        body = f"fld dword ptr [0x{MOP:x}]\n{m} dword ptr [0x{MOP + 4:x}]\nfstp dword ptr [0x{FOUT:x}]"
+    elif form == "st":
+        body = f"fld dword ptr [0x{MOP:x}]\nfld dword ptr [0x{MOP + 4:x}]\n{m} st(0), st(1)\nfstp dword ptr [0x{FOUT:x}]\nfstp dword ptr [0x{FOUT + 4:x}]"
+    else:
+        body = f"fld dword ptr [0x{MOP:x}]\nfld dword ptr [0x{MOP + 4:x}]\n{m}p st(1), st(0)\nfstp dword ptr [0x{FOUT:x}]"
+    return body, "x87"
+
+
+def g_x87_unary(rng):
+    m = rng.choice(["fsqrt", "fabs", "fchs", "fsin", "fcos", "frndint"])
+    return f"fld dword ptr [0x{MOP:x}]\n{m}\nfstp dword ptr [0x{FOUT:x}]", ("x87trig" if m in ("fsin", "fcos") else "x87")
+
+
+def g_x87_binary_special(rng):
+    m = rng.choice(["fpatan", "fyl2x", "fscale", "fprem"])
+    return f"fld dword ptr [0x{MOP:x}]\nfld dword ptr [0x{MOP + 4:x}]\n{m}\nfstp dword ptr [0x{FOUT:x}]", "x87trig"
+
+
+def g_x87_int(rng):
+    k = rng.choice(["fistp", "fild", "fistp_rc", "fist16"])
+    if k == "fistp": return f"fld dword ptr [0x{MOP:x}]\nfistp dword ptr [0x{FOUT:x}]", "x87int"
+    if k == "fild": return f"fild dword ptr [0x{MOP + 8:x}]\nfstp dword ptr [0x{FOUT:x}]", "x87"
+    if k == "fist16": return f"fld dword ptr [0x{MOP:x}]\nfistp word ptr [0x{FOUT:x}]", "x87int"

+        regs[1] = (regs[1] & 0xFFFF0000) | d
+        q = rng.randrange(0, 0x8000); r = rng.randrange(0, d); n = q * d + r
+        if m == "idiv" and rng.random() < 0.5: n = -n
+        n &= 0xFFFFFFFF

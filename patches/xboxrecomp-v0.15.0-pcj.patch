+"""Differential test of the lifter's SSE / MMX / x87 translation against Unicorn.
+
+Same idea as difftest.py, for floating point and SIMD. State block:
+  0x200000  eax..ebp in            0x200040  eax..ebp out
+  0x200100  xmm0..xmm3 in (64 B)   0x200180  xmm0..xmm3 out
+  0x200140  mm0, mm1 in            0x2001C0  mm0, mm1 out
+  0x200150  memory operand (16 B)  0x2001D0  x87 results (fstp targets, 16 B)
+  0x20007C  branch taken
+Floats compare bit-exactly except: any NaN matches any NaN; x87 results may
+differ by 1 ulp (the lifter evaluates x87 in double, the CPU in extended);
+rcpss/rsqrtss are approximations (relative 2^-11).
+
+    python3 -m tools.recomp.difftest_fp [--cases N] [--only GROUP,...]
+"""
+import argparse
+import math
+import os
+import random
+import re
+import struct
+import subprocess
+import sys
+import tempfile
+from collections import defaultdict
+
+import keystone
+import unicorn
+from unicorn import x86_const as U
+
+from . import config
+from .translator import FunctionTranslator
+from . import difftest as D
+
+S = 0x200000
+XIN, XOUT, MIN, MOUT, MOP, FOUT = S + 0x100, S + 0x180, S + 0x140, S + 0x1C0, S + 0x150, S + 0x1D0
+FEDGE = [0.0, -0.0, 1.0, -1.0, 0.5, -0.5, 2.0, 3.0, 0.1, -0.1, 100.0, -100.0, 1e-3, 1e10, -1e10, 1e30, 1e-30,
+         65535.0, 65536.5, -2147483648.0, 2147483520.0, 1.5, 2.5, -2.5, 0.49999997, float("inf"), float("-inf"), 3.4e38,
+         1.17549435e-38, 1e-40, float("nan")]
+
+
+def f2u(f):
+    return struct.unpack("<I", struct.pack("<f", f))[0]
+
+
+def u2f(u):
+    return struct.unpack("<f", struct.pack("<I", u & 0xFFFFFFFF))[0]
+
+
+def rf(rng, edge=0.4, finite=False):
+    if rng.random() < edge:
+        f = rng.choice(FEDGE)
+        if finite and (math.isinf(f) or math.isnan(f)):
+            f = 1.0
+        return f2u(f)
+    e = rng.choice([rng.uniform(-1, 1), rng.uniform(-1000, 1000), rng.uniform(-1e6, 1e6), rng.gauss(0, 10)])
+    return f2u(e)
+
+
+XM = ["xmm0", "xmm1", "xmm2", "xmm3"]
+MM = ["mm0", "mm1"]
+MOPS = f"[0x{MOP:x}]"
+SSE_SCALAR = ["addss", "subss", "mulss", "divss", "minss", "maxss", "sqrtss", "movss", "rcpss", "rsqrtss"]
+SSE_PACKED = ["addps", "subps", "mulps", "divps", "minps", "maxps", "andps", "orps", "xorps", "andnps", "movaps",
+              "unpcklps", "unpckhps", "sqrtps"]
+MMX = ["paddw", "paddd", "paddb", "psubw", "psubd", "pmullw", "pmulhw", "pmaddwd", "pand", "pandn", "por", "pxor",
+       "punpcklbw", "punpcklwd", "punpckldq", "punpckhbw", "punpckhwd", "punpckhdq", "packssdw", "packsswb", "packuswb",
+       "pcmpeqw", "pcmpgtw", "paddsw", "paddusb", "psubusb", "pavgb", "pmaxsw", "pminsw"]
+MMX_SH = ["psraw", "psrad", "psrlw", "psrld", "psrlq", "psllw", "pslld", "psllq"]
+
+
+def g_sse_scalar(rng):
+    m = rng.choice(SSE_SCALAR)
+    src = rng.choice(XM) if rng.random() < 0.7 else "dword ptr " + MOPS
+    return f"{m} {rng.choice(XM)}, {src}", ("approx" if m in ("rcpss", "rsqrtss") else "exact")
+
+
+def g_sse_packed(rng):
+    m = rng.choice(SSE_PACKED)
+    src = rng.choice(XM) if rng.random() < 0.7 else "xmmword ptr " + MOPS
+    return f"{m} {rng.choice(XM)}, {src}", "exact"
+
+
+def g_shufps(rng):

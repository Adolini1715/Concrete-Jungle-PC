diff --git a/tools/recomp/difftest.py b/tools/recomp/difftest.py
new file mode 100644
index 0000000..b2c3011
--- /dev/null
+++ b/tools/recomp/difftest.py
@@ -0,0 +1,503 @@
+"""Differential test of the lifter against a reference x86 CPU (Unicorn).
+
+Each case is a tiny guest function:
+
+    load eax..edi (not esp) and a scratch dword from the state block
+    stc / clc                       ; carry-in for adc/sbb/rcl/inc/dec cases
+    <instruction under test>
+    j<cc> taken  -> state.taken = 1 ; one flag consumer, placed immediately
+    store eax..edi and the scratch dword
+    ret
+
+The same bytes run on Unicorn and, after FunctionTranslator, as compiled C
+against the real runtime header. Registers, memory and the branch outcome
+must agree, except where x86 leaves the result undefined (masked per
+mnemonic). Every mismatch is a lifter bug class like the 8-bit `imul` that
+lost the HUD tint.
+
+    python3 -m tools.recomp.difftest [--cases N] [--seed S] [--only MNEM,...]
+"""
+import argparse
+import os
+import random
+import re
+import subprocess
+import sys
+import tempfile
+from collections import defaultdict
+
+import keystone
+import unicorn
+from unicorn import x86_const as U
+
+from . import config
+from .translator import FunctionTranslator
+
+BASE = 0x10000
+FN_STRIDE = 0x100
+STATE = 0x200000            # in: 7 regs + scratch; out: 7 regs + scratch + taken
+STACK = 0x300000
+REGS = ["eax", "ecx", "edx", "ebx", "esi", "edi", "ebp"]
+SCRATCH = STATE + 0x80
+OUT = STATE + 0x40
+TAKEN = STATE + 0x7C
+HEADER = os.path.join(os.path.dirname(__file__), "..", "..", "templates", "runtime", "recomp_types.h")
+
+JCC = ["jo", "jno", "jb", "jae", "je", "jne", "jbe", "ja", "js", "jns", "jp", "jnp", "jl", "jge", "jle", "jg"]
+# flags each condition reads
+JCC_FLAGS = {"jo": "O", "jno": "O", "jb": "C", "jae": "C", "je": "Z", "jne": "Z", "jbe": "CZ", "ja": "CZ",
+             "js": "S", "jns": "S", "jp": "P", "jnp": "P", "jl": "SO", "jge": "SO", "jle": "ZSO", "jg": "ZSO"}
+
+EDGE = [0, 1, 2, 0x7F, 0x80, 0x81, 0xFF, 0x100, 0x7FFF, 0x8000, 0x8001, 0xFFFF, 0x10000,
+        0x7FFFFFFF, 0x80000000, 0x80000001, 0xFFFFFFFE, 0xFFFFFFFF, 31, 32, 33, 7, 8, 15, 16]
+
+R8 = ["al", "cl", "dl", "bl", "ah", "ch", "dh", "bh"]
+R16 = ["ax", "cx", "dx", "bx", "si", "di", "bp"]
+R32 = ["eax", "ecx", "edx", "ebx", "esi", "edi", "ebp"]
+MEMW = {8: "byte ptr", 16: "word ptr", 32: "dword ptr"}
+
+
+def rv(rng):
+    v = rng.choice(EDGE) if rng.random() < 0.4 else rng.getrandbits(32)
+    if rng.random() < 0.2:
+        v ^= rng.getrandbits(8)
+    return v & 0xFFFFFFFF
+
+
+def reg(rng, w):
+    return rng.choice({8: R8, 16: R16, 32: R32}[w])
+
+
+def mem(w):
+    return f"{MEMW[w]} [0x{SCRATCH:x}]"
+
+
+# ---------------- instruction generators: (asm, defined-flags, notes) ----------------
+ALL = "CZSOP"
+
+
+def g_alu(m):
+    def f(rng):
+        w = rng.choice([8, 16, 32]); k = rng.random()
+        if k < 0.4: ops = f"{reg(rng, w)}, {reg(rng, w)}"
+        elif k < 0.6: ops = f"{reg(rng, w)}, {rv(rng) & ((1 << w) - 1)}"
+        elif k < 0.8: ops = f"{mem(w)}, {reg(rng, w)}"
+        else: ops = f"{reg(rng, w)}, {mem(w)}"
+        return f"{m} {ops}", ALL
+    return f
+
+
+def g_unary(m, flags):
+    def f(rng):
+        w = rng.choice([8, 16, 32])
+        return f"{m} {reg(rng, w) if rng.random() < 0.7 else mem(w)}", flags
+    return f
+
+
+def g_shift(m):
+    def f(rng):
+        w = rng.choice([8, 16, 32])
+        dst = reg(rng, w) if rng.random() < 0.8 else mem(w)
+        if dst.startswith("cl") or dst.startswith("ch") or dst in ("cx", "ecx"):
+            dst = mem(w)
+        k = rng.random()
+        if k < 0.3: cnt, c = "1", 1
+        elif k < 0.7: c = rng.choice([0, 1, 2, 3, 7, 8, 9, 15, 16, 17, 31, rng.randrange(32)]); cnt = str(c)
+        else: cnt, c = "cl", None
+        return f"{m} {dst}, {cnt}", ("SHIFT", m, w, c)
+    return f
+
+
+def g_double_shift(m):
+    def f(rng):
+        w = rng.choice([16, 32])
+        a, b = reg(rng, w), reg(rng, w)
+        c = rng.choice([0, 1, 2, 7, 8, 15, 16, 17, 31])
+        return f"{m} {a}, {b}, {c}", ("DSHIFT", m, w, c)
+    return f
+
+
+def g_muldiv1(m):
+    def f(rng):
+        w = rng.choice([8, 16, 32])
+        src = reg(rng, w) if rng.random() < 0.7 else mem(w)
+        return f"{m} {src}", ("MULDIV", m, w)
+    return f
+
+
+def g_imul23(rng):
+    w = rng.choice([16, 32])
+    if rng.random() < 0.5:
+        return f"imul {reg(rng, w)}, {reg(rng, w) if rng.random() < 0.7 else mem(w)}", "CO"
+    imm = rng.choice([3, 7, -1, 100, 0x7F, -128, 1000, 0x1234])
+    return f"imul {reg(rng, w)}, {reg(rng, w)}, {imm}", "CO"
+
+
+def g_movx(m):
+    def f(rng):
+        w = rng.choice([16, 32]); sw = rng.choice([8, 16]) if w == 32 else 8
+        src = reg(rng, sw) if rng.random() < 0.7 else mem(sw)
+        return f"{m} {reg(rng, w)}, {src}", ""
+    return f
+
+
+def g_bt(m):
+    def f(rng):
+        w = rng.choice([16, 32])
+        if rng.random() < 0.5: src = str(rng.randrange(w))
+        else: src = reg(rng, w)
+        dst = reg(rng, w)
+        return f"{m} {dst}, {src}", "C"
+    return f
+
+
+def g_bs(m):
+    def f(rng):
+        w = rng.choice([16, 32])
+        return f"{m} {reg(rng, w)}, {reg(rng, w)}", ("BS", m)
+    return f
+
+
+def g_misc(rng):
+    k = rng.choice(["bswap", "xchg", "xchgm", "lea", "not", "cdq", "cwde", "cbw", "cwd", "setcmp", "cmov", "xadd",
+                    "cmpxchg", "sahf", "lahf", "movsx_self", "neg"])
+    if k == "bswap": return f"bswap {reg(rng, 32)}", ""
+    if k == "xchg": w = rng.choice([8, 16, 32]); return f"xchg {reg(rng, w)}, {reg(rng, w)}", ""
+    if k == "xchgm": w = rng.choice([8, 16, 32]); return f"xchg {mem(w)}, {reg(rng, w)}", ""
+    if k == "lea": return f"lea {reg(rng, 32)}, [{reg(rng, 32)} + {reg(rng, 32)}*{rng.choice([1, 2, 4, 8])} + {rng.randrange(-200, 200)}]", ""
+    if k == "not": w = rng.choice([8, 16, 32]); return f"not {reg(rng, w)}", ""
+    if k == "cdq": return "cdq", ""
+    if k == "cwde": return "cwde", ""
+    if k == "cbw": return "cbw", ""
+    if k == "cwd": return "cwd", ""
+    if k == "setcmp":
+        w = rng.choice([8, 16, 32]); cc = rng.choice(JCC)[1:]
+        return f"cmp {reg(rng, w)}, {reg(rng, w)}\nset{cc} {reg(rng, 8)}", ALL
+    if k == "cmov":
+        w = rng.choice([16, 32]); cc = rng.choice(JCC)[1:]
+        return f"cmp {reg(rng, 32)}, {reg(rng, 32)}\ncmov{cc} {reg(rng, w)}, {reg(rng, w)}", ALL
+    if k == "xadd": w = rng.choice([8, 16, 32]); return f"xadd {reg(rng, w)}, {reg(rng, w)}", ALL
+    if k == "cmpxchg": w = rng.choice([8, 16, 32]); return f"cmpxchg {mem(w)}, {reg(rng, w)}", "Z"
+    if k == "sahf": return "sahf", "CZSP"
+    if k == "lahf": return "lahf", ""
+    if k == "movsx_self": return f"movsx {rng.choice(R32)}, {rng.choice(['al', 'ah', 'cl', 'ch'])}", ""
+    return f"neg {reg(rng, rng.choice([8, 16, 32]))}", ALL
+
+
+GENS = {
+    "add": g_alu("add"), "adc": g_alu("adc"), "sub": g_alu("sub"), "sbb": g_alu("sbb"), "cmp": g_alu("cmp"),
+    "and": g_alu("and"), "or": g_alu("or"), "xor": g_alu("xor"), "test": g_alu("test"),
+    "inc": g_unary("inc", "ZSOP"), "dec": g_unary("dec", "ZSOP"), "neg": g_unary("neg", ALL), "not": g_unary("not", ""),
+    "shl": g_shift("shl"), "shr": g_shift("shr"), "sar": g_shift("sar"), "rol": g_shift("rol"), "ror": g_shift("ror"),
+    "rcl": g_shift("rcl"), "rcr": g_shift("rcr"),
+    "shld": g_double_shift("shld"), "shrd": g_double_shift("shrd"),
+    "mul": g_muldiv1("mul"), "imul1": g_muldiv1("imul"), "div": g_muldiv1("div"), "idiv": g_muldiv1("idiv"),
+    "imul23": g_imul23, "movsx": g_movx("movsx"), "movzx": g_movx("movzx"),
+    "bt": g_bt("bt"), "bts": g_bt("bts"), "btr": g_bt("btr"), "btc": g_bt("btc"),
+    "bsf": g_bs("bsf"), "bsr": g_bs("bsr"), "misc": g_misc,
+}
+
+
+def defined_flags(spec, regs_in, scratch_in, cf_in, asm):
+    """Flags x86 defines for this instance (others are masked)."""
+    if isinstance(spec, str):
+        return spec
+    kind = spec[0]
+    if kind in ("SHIFT", "DSHIFT"):
+        _, m, w, c = spec
+        if c is None:
+            c = regs_in[1] & 0xFF                  # cl
+        c &= 31
+        if m in ("rcl", "rcr"):
+            if w == 8: c %= 9
+            elif w == 16: c %= 17
+        if c == 0:
+            return "CZSOP"                         # flags unchanged: all must match the input
+        if m in ("rol", "ror", "rcl", "rcr"):
+            return "CO" if c == 1 else "C"
+        if kind == "DSHIFT" and c > w:
+            return ""
+        if m in ("shl", "shr") and c > w:
+            return "ZSP"
+        return "CZSOP" if c == 1 else "CZSP"
+    if kind == "MULDIV":
+        return "CO" if spec[1] in ("mul", "imul") else ""
+    if kind == "BS":
+        return "Z"
+    return ALL
+
+
+def build_case(rng, gen_name):
+    body, spec = GENS[gen_name](rng)
+    regs_in = [rv(rng) for _ in REGS]
+    scratch = rv(rng)
+    cf_in = rng.random() < 0.5
+    jcc = rng.choice(JCC)
+    # avoid faulting divides: make the divisor safe and the quotient fit
+    if body.startswith(("div ", "idiv ")):
+        return None
+    return dict(gen=gen_name, body=body, spec=spec, regs=regs_in, scratch=scratch, cf=cf_in, jcc=jcc)
+
+
+def fix_divide(case, rng):
+    """Divides: pick operands whose quotient fits (x86 faults otherwise)."""
+    m, src = case["body"].split(" ", 1)
+    w = 8 if src.startswith(("byte", "al", "cl", "dl", "bl", "ah", "ch", "dh", "bh")) and not src.startswith("bp") else None
+    if w is None:
+        w = 16 if (src.startswith("word") or src in R16) else 32
+    return case
+
+
+def asm_for(case, idx):
+    lines = []
+    for i, r in enumerate(REGS):
+        lines.append(f"mov {r}, dword ptr [0x{STATE + 4 * i:x}]")
+    lines.append("stc" if case["cf"] else "clc")
+    lines.extend(case["body"].split("\n"))
+    lines.append(f"{case['jcc']} L_t{idx}")
+    lines.append(f"mov byte ptr [0x{TAKEN:x}], 0")
+    lines.append(f"jmp L_d{idx}")
+    lines.append(f"L_t{idx}:")
+    lines.append(f"mov byte ptr [0x{TAKEN:x}], 1")
+    lines.append(f"L_d{idx}:")
+    for i, r in enumerate(REGS):
+        lines.append(f"mov dword ptr [0x{OUT + 4 * i:x}], {r}")
+    lines.append("ret")
+    return "\n".join(lines)
+
+
+def run_unicorn(code, addr, case):
+    mu = unicorn.Uc(unicorn.UC_ARCH_X86, unicorn.UC_MODE_32)
+    mu.mem_map(0, 0x400000)
+    mu.mem_write(addr, code)
+    for i, v in enumerate(case["regs"]):
+        mu.mem_write(STATE + 4 * i, v.to_bytes(4, "little"))
+    mu.mem_write(SCRATCH, case["scratch"].to_bytes(4, "little"))
+    mu.reg_write(U.UC_X86_REG_ESP, STACK - 4)
+    mu.mem_write(STACK - 4, (0x0FFF0).to_bytes(4, "little"))
+    try:
+        mu.emu_start(addr, 0x0FFF0, count=10000)
+    except unicorn.UcError as e:
+        return None
+    out = [int.from_bytes(mu.mem_read(OUT + 4 * i, 4), "little") for i in range(len(REGS))]
+    sc = int.from_bytes(mu.mem_read(SCRATCH, 4), "little")
+    taken = mu.mem_read(TAKEN, 1)[0]
+    return out, sc, taken
+

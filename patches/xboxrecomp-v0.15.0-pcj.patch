     return false;
 }
 #endif
+
+#if !defined(_WIN32) && defined(__x86_64__)
+/* POSIX x86-64: the shared x86-64 decoder (mmio_decode.h) over the signal
+ * handler's ucontext. Registers are copied into the decoder's context and
+ * back, so the decoder stays the one Windows uses. */
+#include <signal.h>
+#include <ucontext.h>
+#define MMIO_DECODE_POSIX_CONTEXT 1
+#include "../platform/mmio_decode.h"
+
+#define APU_MMIO_BASE  0xFE800000u
+#define APU_MMIO_SIZE  0x00080000u
+
+static int g_apu_mmio_decode_fail;
+
+static uint64_t apu_mmio_rd(void *dev, uint32_t off, int size)
+{
+    if (size == 8) {
+        uint64_t lo = mcpx_apu_mmio_read((MCPXAPUState *)dev, off, 4);
+        uint64_t hi = mcpx_apu_mmio_read((MCPXAPUState *)dev, off + 4, 4);
+        return lo | (hi << 32);
+    }
+    return mcpx_apu_mmio_read((MCPXAPUState *)dev, off, (unsigned)size);
+}
+
+static void apu_mmio_wr(void *dev, uint32_t off, uint64_t v, int size)
+{
+    if (size == 8) {
+        mcpx_apu_mmio_write((MCPXAPUState *)dev, off, (uint32_t)v, 4);
+        mcpx_apu_mmio_write((MCPXAPUState *)dev, off + 4, (uint32_t)(v >> 32), 4);
+        return;
+    }
+    mcpx_apu_mmio_write((MCPXAPUState *)dev, off, v, (unsigned)size);
+}
+
+bool apu_hook_handle_mmio_posix(void *ucv, uintptr_t fault_addr,
+                                uint32_t fault_xbox_va, int is_write)
+{
+    ucontext_t *uc = (ucontext_t *)ucv;
+    greg_t *g = uc->uc_mcontext.gregs;
+    uint32_t off = fault_xbox_va - APU_MMIO_BASE;
+    MMIO_CONTEXT c;
+    int ok;
+
+    (void)fault_addr; (void)is_write;
+    if (!g_apu_state || off >= APU_MMIO_SIZE)
+        return false;
+    c.Rax = g[REG_RAX]; c.Rcx = g[REG_RCX]; c.Rdx = g[REG_RDX]; c.Rbx = g[REG_RBX];
+    c.Rsp = g[REG_RSP]; c.Rbp = g[REG_RBP]; c.Rsi = g[REG_RSI]; c.Rdi = g[REG_RDI];
+    c.R8 = g[REG_R8];   c.R9 = g[REG_R9];   c.R10 = g[REG_R10]; c.R11 = g[REG_R11];
+    c.R12 = g[REG_R12]; c.R13 = g[REG_R13]; c.R14 = g[REG_R14]; c.R15 = g[REG_R15];
+    c.Rip = g[REG_RIP]; c.EFlags = (uint32_t)g[REG_EFL];
+    ok = mmio_emulate(&c, off, g_apu_state, apu_mmio_rd, apu_mmio_wr);
+    if (ok) {
+        g[REG_RAX] = c.Rax; g[REG_RCX] = c.Rcx; g[REG_RDX] = c.Rdx; g[REG_RBX] = c.Rbx;
+        g[REG_RSP] = c.Rsp; g[REG_RBP] = c.Rbp; g[REG_RSI] = c.Rsi; g[REG_RDI] = c.Rdi;
+        g[REG_R8] = c.R8;   g[REG_R9] = c.R9;   g[REG_R10] = c.R10; g[REG_R11] = c.R11;
+        g[REG_R12] = c.R12; g[REG_R13] = c.R13; g[REG_R14] = c.R14; g[REG_R15] = c.R15;
+        g[REG_RIP] = c.Rip; g[REG_EFL] = (greg_t)((g[REG_EFL] & ~0xFFFFFFFFll) | c.EFlags);
+        return true;
+    }
+    if (++g_apu_mmio_decode_fail <= 20) {
+        const uint8_t *ip = (const uint8_t *)(uintptr_t)g[REG_RIP];
+        fprintf(stderr, "[APU] MMIO decode fail at RIP=%p offset=0x%X: %02X %02X %02X %02X %02X %02X\n",
+                (void *)ip, off, ip[0], ip[1], ip[2], ip[3], ip[4], ip[5]);
+    }
+    return false;
+}
+#endif

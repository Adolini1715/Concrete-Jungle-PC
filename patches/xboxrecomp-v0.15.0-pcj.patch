+int xbox_worker_stacks(uint32_t *lo, uint32_t *hi, int max)
+{
+    int i, n = 0;
+    for (i = 0; i < XBOX_MAX_THREAD_STACKS; i++)
+        if (g_thread_stack_tops[i]) {
+            if (n < max) { hi[n] = g_thread_stack_tops[i] + 16; lo[n] = hi[n] - XBOX_THREAD_STACK_SIZE; }
+            n++;
+        }
+    return n;
+}
+/* Park the GPU walk between ticks (1) or let it run (0). Returns 1 once it is
+ * parked, 0 on timeout. With wait_idle, first let it drain to DMA_PUT. */
+int xbox_nv2a_pause(int on, int wait_idle)
+{
+    int i;
+    if (!on) { InterlockedExchange(&g_nv2a_ack_pause, 0); return 1; }
+    if (!g_nv2a_ack_thread) return 1;
+    if (wait_idle && g_nv2a_memory)
+        for (i = 0; i < 2000; i++) {   /* up to ~2 s */
+            uint32_t put = *(volatile uint32_t *)((char *)g_nv2a_memory + NV2A_USER_DMA_PUT);
+            uint32_t get = *(volatile uint32_t *)((char *)g_nv2a_memory + NV2A_USER_DMA_GET);
+            if (put == get && s_ack_last_put == put) break;
+            Sleep(1);
+        }
+    InterlockedExchange(&g_nv2a_ack_pause, 1);
+    for (i = 0; i < 2000; i++) {
+        if (g_nv2a_ack_parked) return 1;
+        Sleep(1);
+    }
+    return 0;
+}
+
+int xbox_layout_snap_regions(XboxSnapRegion *r, int max)
+{
+    int n = 0;
+#define SNAPL(ptr, size, nm) do { if (n < max) { r[n].p = (void *)(ptr); r[n].n = (size); r[n].name = nm; } n++; } while (0)
+    SNAPL(&s_ack_last_put, sizeof s_ack_last_put, "ack.last_put");
+    SNAPL(&s_ack_get_written, sizeof s_ack_get_written, "ack.get_written");
+    SNAPL(&s_ack_put_lo, sizeof s_ack_put_lo, "ack.put_lo");
+    SNAPL(&s_ack_put_hi, sizeof s_ack_put_hi, "ack.put_hi");
+    if (g_nv2a_memory) SNAPL(g_nv2a_memory, XBOX_NV2A_SIZE, "nv2a.mmio");
+    /* The contiguous window is its own mapping, not a mirror of RAM: D3D's
+     * pushbuffer and textures, the kernel data block and the front end's
+     * heaps live there. */
+    if (g_contig_memory) SNAPL(g_contig_memory, XBOX_CONTIG_SIZE, "contig.mem");
+    SNAPL(&g_heap_next, sizeof g_heap_next, "heap.next");
+    SNAPL(&g_heap_alloc_count, sizeof g_heap_alloc_count, "heap.count");
+    SNAPL(g_heap_blocks, sizeof g_heap_blocks, "heap.blocks");
+    SNAPL(&g_heap_block_count, sizeof g_heap_block_count, "heap.nblocks");
+    SNAPL(g_contig_used, sizeof g_contig_used, "contig.used");
+    SNAPL(g_contig_len, sizeof g_contig_len, "contig.len");
+    SNAPL(&g_contig_pages_in_use, sizeof g_contig_pages_in_use, "contig.inuse");
+    SNAPL(&g_contig_high, sizeof g_contig_high, "contig.high");
+    SNAPL(&g_contig_first_free, sizeof g_contig_first_free, "contig.firstfree");
+#undef SNAPL
+    return n;
+}

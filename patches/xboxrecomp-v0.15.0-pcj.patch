+def divide_case(rng, g):
+    """div/idiv with operands chosen so the quotient fits (no #DE)."""
+    m = g
+    w = rng.choice([8, 16, 32])
+    regs = [rv(rng) for _ in REGS]
+    scratch = rv(rng)
+    if w == 8:
+        d = rng.randrange(1, 256)
+        src_r = rng.choice(["cl", "bl", "dl", "ch", "bh", "dh"])
+        idx = {"cl": 1, "bl": 3, "dl": 2, "ch": 1, "bh": 3, "dh": 2}[src_r]
+        sh = 8 if src_r.endswith("h") else 0
+        if m == "idiv": d = rng.choice([1, 2, 3, 7, 100, 127]) * rng.choice([1, -1])
+        regs[idx] = (regs[idx] & ~(0xFF << sh)) | ((d & 0xFF) << sh)
+        q = rng.randrange(0, 128); r = rng.randrange(0, abs(d))
+        n = q * abs(d) + r
+        if m == "idiv" and rng.random() < 0.5: n = -n

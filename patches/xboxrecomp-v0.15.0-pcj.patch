+    for k in range(4):
+        if w(ref, 0x150 + 4 * k) != w(g, 0x150 + 4 * k):
+            probs.append(f"mem[{k}]: x86={w(ref, 0x150 + 4 * k):08X} C={w(g, 0x150 + 4 * k):08X}")
+    # x87 results
+    for k in range(3):
+        a_, b_ = w(ref, 0x1D0 + 4 * k), w(g, 0x1D0 + 4 * k)
+        if kind == "x87int":
+            ok = a_ == b_
+        elif kind == "x87trig":

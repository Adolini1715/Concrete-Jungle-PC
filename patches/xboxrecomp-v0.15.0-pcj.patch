+++ b/src/kernel/nv2a_gpu_census.c
@@ -0,0 +1,278 @@
+/*
+ * GPU census (RECOMP_GPU_CENSUS=<path>): an inventory of what a title asks
+ * the NV2A to do, for planning a hardware back end. Read-only: it shadows the
+ * methods the executor sees and never changes executor state. Unset, the
+ * cost is one cached test per method.
+ *
+ * Every 32 flips (and at RECOMP_GPU_CENSUS_EVERY flips) the whole inventory
+ * is rewritten to <path>:
+ *   M  subch method count first_flip last_param      every method
+ *   O  subch class_handle                              object bindings (method 0)
+ *   P  hash len draws first_flip                       vertex programs drawn with
+ *   R  hash stages draws first_flip control stage_prog   combiner configs drawn with
+ *   T  fmt dim cube levels w h pitch draws first_flip rtt   textures sampled
+ *   S  fmt pitch w h aa draws first_flip              colour surfaces drawn to
+ *   V  attr type size stride draws                    vertex attribute formats
+ *   D  prim draws mode                                primitive types / xform mode
+ *   X  key value                                      scalar counters
+ */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int s_on = -1;
+static const char *s_path;
+static uint32_t s_every = 32;
+
+static uint32_t s_reg[0x2000 / 4];
+static uint32_t s_flips;
+
+/* methods: 8 subchannels x 2048 words */
+static uint32_t s_mcount[8][0x2000 / 4];
+static uint32_t s_mfirst[8][0x2000 / 4];
+static uint32_t s_mlast[8][0x2000 / 4];
+static uint32_t s_obj[8];
+
+/* vertex program shadow: 136 slots x 4 words */
+static uint32_t s_prog[136][4];
+static uint32_t s_prog_load;
+
+#define TBL 1024
+typedef struct { uint64_t key; uint32_t draws, first; uint32_t a[8]; } Ent;
+static Ent s_vp[TBL], s_rc[TBL], s_tex[TBL], s_surf[TBL], s_va[TBL], s_prim[TBL];
+static uint32_t s_nvp, s_nrc, s_ntex, s_nsurf, s_nva, s_nprim;
+
+/* colour surface addresses drawn to (for render-to-texture detection) */
+static uint32_t s_rt[256];
+static uint32_t s_nrt;
+
+static uint64_t s_draws, s_draws_prog, s_draws_ffp, s_rtt_draws, s_tex_draws;
+static uint64_t s_inline_words, s_index_words, s_imm_words, s_prog_words, s_const_words;
+
+static uint64_t fnv(const void *p, size_t n, uint64_t h)
+{
+    const uint8_t *b = (const uint8_t *)p;
+    while (n--) { h ^= *b++; h *= 0x100000001B3ull; }
+    return h;
+}
+
+static Ent *bump(Ent *t, uint32_t *n, uint64_t key)
+{
+    uint32_t i;
+    for (i = 0; i < *n; i++)
+        if (t[i].key == key) { t[i].draws++; return &t[i]; }
+    if (*n >= TBL)
+        return NULL;
+    t[*n].key = key; t[*n].draws = 1; t[*n].first = s_flips;
+    return &t[(*n)++];
+}
+
+#define R(m) s_reg[(m) / 4]
+
+static void dump(void)
+{
+    FILE *f;
+    uint32_t s, m, i;
+    char tmp[1024];
+
+    snprintf(tmp, sizeof tmp, "%s.tmp", s_path);
+    if (!(f = fopen(tmp, "w")))
+        return;
+    fprintf(f, "X flips %u\nX draws %llu\nX draws_program %llu\nX draws_ffp %llu\n"
+            "X draws_textured %llu\nX draws_rtt %llu\nX inline_words %llu\n"
+            "X index_words %llu\nX immediate_words %llu\nX program_words %llu\n"
+            "X constant_words %llu\n", s_flips,
+            (unsigned long long)s_draws, (unsigned long long)s_draws_prog,
+            (unsigned long long)s_draws_ffp, (unsigned long long)s_tex_draws,
+            (unsigned long long)s_rtt_draws, (unsigned long long)s_inline_words,
+            (unsigned long long)s_index_words, (unsigned long long)s_imm_words,
+            (unsigned long long)s_prog_words, (unsigned long long)s_const_words);
+    for (s = 0; s < 8; s++)
+        if (s_obj[s])
+            fprintf(f, "O %u 0x%08X\n", s, s_obj[s]);
+    for (s = 0; s < 8; s++)
+        for (m = 0; m < 0x2000 / 4; m++)
+            if (s_mcount[s][m])
+                fprintf(f, "M %u 0x%04X %u %u 0x%08X\n", s, m * 4,
+                        s_mcount[s][m], s_mfirst[s][m], s_mlast[s][m]);
+    for (i = 0; i < s_nvp; i++)
+        fprintf(f, "P %016llx %u %u %u\n", (unsigned long long)s_vp[i].key,
+                s_vp[i].a[0], s_vp[i].draws, s_vp[i].first);
+    for (i = 0; i < s_nrc; i++)
+        fprintf(f, "R %016llx %u %u %u 0x%08X 0x%08X\n", (unsigned long long)s_rc[i].key,
+                s_rc[i].a[0], s_rc[i].draws, s_rc[i].first, s_rc[i].a[1], s_rc[i].a[2]);
+    for (i = 0; i < s_ntex; i++)
+        fprintf(f, "T 0x%02X %u %u %u %u %u %u %u %u %u\n", s_tex[i].a[0], s_tex[i].a[1],
+                s_tex[i].a[2], s_tex[i].a[3], s_tex[i].a[4], s_tex[i].a[5], s_tex[i].a[6],
+                s_tex[i].draws, s_tex[i].first, s_tex[i].a[7]);
+    for (i = 0; i < s_nsurf; i++)
+        fprintf(f, "S 0x%08X %u %u %u %u %u %u 0x%08X\n", s_surf[i].a[0], s_surf[i].a[1],
+                s_surf[i].a[2], s_surf[i].a[3], s_surf[i].a[4], s_surf[i].draws,
+                s_surf[i].first, s_surf[i].a[5]);
+    for (i = 0; i < s_nva; i++)
+        fprintf(f, "V %u %u %u %u %u\n", s_va[i].a[0], s_va[i].a[1], s_va[i].a[2],
+                s_va[i].a[3], s_va[i].draws);
+    for (i = 0; i < s_nprim; i++)
+        fprintf(f, "D %u %u %u\n", s_prim[i].a[0], s_prim[i].draws, s_prim[i].a[1]);
+    fclose(f);
+    rename(tmp, s_path);
+}
+
+static void on_draw(void)
+{
+    uint32_t mode = R(0x1E94) & 3, i, st;
+    uint32_t color_off = R(0x0210), sfmt = R(0x0208);
+    uint32_t stage_prog = R(0x1E70);
+    int rtt = 0, textured = 0;
+    Ent *e;
+
+    s_draws++;
+    if (mode == 2) {
+        /* program from SET_TRANSFORM_PROGRAM_START to the first final flag */
+        uint32_t start = R(0x1EA0), n = 0;
+        uint64_t h = 0xCBF29CE484222325ull;
+        for (i = start; i < 136; i++) {
+            h = fnv(s_prog[i], 16, h);
+            n++;
+            if (s_prog[i][3] & 1)
+                break;
+        }
+        if ((e = bump(s_vp, &s_nvp, h)))
+            e->a[0] = n;

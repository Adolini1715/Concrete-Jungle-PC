+void nv2a_gpu_census_method(uint32_t subch, uint32_t method, uint32_t param)
+{
+    uint32_t w;
+
+    if (s_on == 0)
+        return;
+    if (s_on < 0) {
+        const char *e = getenv("RECOMP_GPU_CENSUS"), *ev;
+        s_on = e && *e;
+        if (!s_on)
+            return;
+        s_path = e;
+        if ((ev = getenv("RECOMP_GPU_CENSUS_EVERY")) && atoi(ev) > 0)
+            s_every = (uint32_t)atoi(ev);
+        fprintf(stderr, "  [CENSUS] GPU census -> %s every %u flips\n", s_path, s_every);
+    }
+    subch &= 7;
+    w = (method & 0x1FFCu) / 4;
+    if (!s_mcount[subch][w]++)
+        s_mfirst[subch][w] = s_flips;
+    s_mlast[subch][w] = param;
+    if (method == 0)
+        s_obj[subch] = param;
+    if (subch != 0)
+        return;
+
+    /* bulk data: counted, not shadowed as state */
+    if (method == 0x1818) { s_inline_words++; return; }
+    if (method == 0x1800 || method == 0x1808 || method == 0x1810) s_index_words++;
+    if (method >= 0x1500 && method < 0x1A80 && method != 0x17FC
+        && !(method >= 0x1800 && method < 0x1820)) s_imm_words++;
+    if (method >= 0x0B80 && method < 0x0C00) s_const_words++;
+
+    if (method >= 0x0B00 && method < 0x0B80) {
+        uint32_t c = ((method - 0x0B00) / 4) & 3;
+        if (s_prog_load < 136)
+            s_prog[s_prog_load][c] = param;
+        if (c == 3)
+            s_prog_load++;
+        s_prog_words++;
+        return;
+    }
+    if (method == 0x1E9C)
+        s_prog_load = param;
+    if (method == 0x17FC && param == 0)
+        on_draw();
+    s_reg[w] = param;
+    if (method == 0x012C) {   /* FLIP_INCREMENT_WRITE */
+        s_flips++;
+        if (s_flips % s_every == 0)
+            dump();
+    }
+}
+
+/* Called at exit or on demand. */
+void nv2a_gpu_census_flush(void)
+{
+    if (s_on > 0)
+        dump();
+}

+def fdesc(u):
+    return f"{u:08X}({u2f(u):.9g})"
+
+
+def fl_eq(a, b, ulps=0, rel=0.0):
+    if a == b: return True
+    fa, fb = u2f(a), u2f(b)
+    if math.isnan(fa) and math.isnan(fb): return True
+    if rel and math.isfinite(fa) and math.isfinite(fb) and abs(fa - fb) <= rel * max(abs(fa), abs(fb)): return True
+    if ulps and (a ^ b) >> 31 == 0 and abs(a - b) <= ulps: return True
+    return False
+
+
+def compare(c, ref, g):
+    probs = []
+    kind = c["kind"]
+    w = lambda b, o: int.from_bytes(b[o:o + 4], "little")
+    # integer registers
+    for k, r in enumerate(D.REGS):

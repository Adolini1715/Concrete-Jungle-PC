+    if k == "cvtsi2ss_m": return f"cvtsi2ss {rng.choice(XM)}, dword ptr {MOPS}", "exact"
+    if k == "cvttss2si": return f"cvttss2si {rng.choice(D.R32)}, {rng.choice(XM)}", "exact"
+    if k == "cvtss2si": return f"cvtss2si {rng.choice(D.R32)}, {rng.choice(XM)}", "exact"
+    return f"cvttss2si {rng.choice(D.R32)}, dword ptr {MOPS}", "exact"
+
+
+def g_mmx(rng):
+    m = rng.choice(MMX)
+    src = rng.choice(MM) if rng.random() < 0.7 else "qword ptr " + MOPS
+    return f"{m} {rng.choice(MM)}, {src}", "exact"
+
+
+def g_mmx_shift(rng):
+    m = rng.choice(MMX_SH)
+    cnt = str(rng.choice([0, 1, 2, 3, 7, 8, 15, 16, 17, 31, 32, 33, 63, 64, rng.randrange(80)])) if rng.random() < 0.7 else rng.choice(MM)
